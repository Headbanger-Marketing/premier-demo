---
import Base from '../../layouts/Base.astro';
import { SITE, LOCATIONS, AREAS } from '../../data/site.js';

// Plain Google Maps search URL. No embedded iframe: a third party frame costs
// performance and leaks visitor data for no real gain over a link.
const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=176+Metcalfe+St+E+Strathroy+ON+N7G+1P6';
const addressLine = `${SITE.address.city}, ${SITE.address.region} ${SITE.address.postal}`;
---

<Base
  title="Contact Premier Heating & Cooling | Strathroy and London"
  description="Contact Premier Heating & Cooling in Strathroy. Call (519) 245-5945, email info@premierheating.ca or send the form. Serving London, St. Thomas and area."
  path="/contact/"
  active="contact"
>
  <!-- Page header -->
  <section class="section section--tight bg-steel page-head">
    <div class="container page-head__inner">
      <h1>Contact {SITE.name}</h1>
      <p class="lede">
        Call the shop in Strathroy, send the form below, or email us, and we will get back to you as soon as we can.
      </p>
      <a class="btn btn--primary" href={SITE.phoneHref}>Call {SITE.phone}</a>
    </div>
  </section>

  <!-- Form + details -->
  <section class="section contact">
    <div class="container contact__grid reveal">
      <form class="card contact-form" id="contact-form" action={SITE.webhookUrl} method="POST" onsubmit="if(this.dataset.intakeReady !== 'true') return false" novalidate>
        <h2>Get A Free Quote</h2>
        <p class="contact-form__note">
          Tell us what you need. Questions are welcome too, you do not have to be ready to book anything.
        </p>

        <div class="form-grid">
          <div class="field">
            <label for="c-name">Name</label>
            <input id="c-name" name="name" type="text" autocomplete="name" required />
            <p class="error" id="c-name-error">Name is empty. Enter your name so we know who to ask for.</p>
          </div>

          <div class="field field--full">
            <label for="c-preferred">How should we contact you?</label>
            <select id="c-preferred" name="preferred_contact"><option value="phone">Phone call</option><option value="email">Email</option></select>
          </div>
          <div class="field" data-contact-field="phone">
            <label for="c-phone">Phone *</label>
            <input id="c-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
            <p class="error" id="c-phone-error">
              Enter a phone number we can reach you at, 10 digits like 519 245 5945.
            </p>
          </div>

          <div class="field field--full" data-contact-field="email" hidden>
            <label for="c-email">Email *</label>
            <input id="c-email" name="email" type="email" autocomplete="email" />
            <p class="error" id="c-email-error">That email address looks incomplete. Enter it like name@example.com.</p>
          </div>

          <div class="field field--full">
            <label for="c-message">What do you need done?</label>
            <textarea id="c-message" name="message" rows="5" autocomplete="off" required></textarea>
            <p class="error" id="c-message-error">
              Add a line or two about the job so we can send the right person and the right parts.
            </p>
          </div>

          <div class="field"><label for="c-city">City / Town (optional)</label><input id="c-city" name="city" type="text" autocomplete="address-level2" /></div>
          <div class="field"><label for="c-postal">Postal code (optional)</label><input id="c-postal" name="postal" type="text" autocomplete="postal-code" maxlength="7" /></div>
          <div class="visually-hidden" aria-hidden="true">
            <label for="c-company">Company</label>
            <input id="c-company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>

        <div class="contact-form__actions">
          <button class="btn btn--primary" type="submit" disabled>Get A Free Quote</button>
          <p class="contact-form__hint form-fallback">If this form has not loaded, <a href={`mailto:${SITE.email}`}>email us</a> to request a follow-up.</p>
          <p class="contact-form__hint" role="status" aria-live="polite" aria-atomic="true">Your request goes to the service team. Service availability and appointments are confirmed separately.</p>
        </div>
      </form>

      <div id="contact-success" class="card contact-success" role="status" hidden>
        <h2 id="contact-success-title" tabindex="-1">Request received</h2>
        <p>Your request has been accepted. The service team will review it and confirm service availability and the next step.</p>
        <p>If you need to discuss the request, call us:</p>
        <p class="contact-success__phone">
          <a href={SITE.phoneHref}>{SITE.phone}</a>
        </p>
        <p>
          You can also email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> directly.
        </p>
      </div>

      <div class="details">
        <h2>Where to find us</h2>

        <ul class="details__list">
          <li>
            <span class="details__label">Shop</span>
            <address>
              {SITE.address.street}<br />
              {addressLine}
            </address>
            <a class="details__action" href={mapsUrl} target="_blank" rel="noopener">
              Get directions<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>

          <li>
            <span class="details__label">Phone</span>
            <a class="details__value" href={SITE.phoneHref}>{SITE.phone}</a>
          </li>

          <li>
            <span class="details__label">Email</span>
            <a class="details__value details__value--email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
        </ul>

        <p class="details__note">
          Emergency service is available. If you have no heat or no cooling, call rather than email so we can get moving
          on it.
        </p>
        <p class="details__note">Licensed, insured, TSSA registered and WSIB covered. Authorized Lennox dealer.</p>
        <p class="details__note">{SITE.familyLine}</p>
      </div>
    </div>
  </section>

  <!-- Service area -->
  <section class="section areas" id="service-area">
    <div class="container reveal">
      <div class="areas__head">
        <p class="eyebrow">Service area</p>
        <h2>Towns we run calls to</h2>
        <hr class="temp-rule temp-rule--short" />
        <p class="lede">
          We work out of Strathroy and cover homes and job sites across Middlesex County and the towns around it.
        </p>
      </div>

      <ul class="area-list">
        {AREAS.map((a) => <li>{a}</li>)}
      </ul>

      {LOCATIONS.length > 0 && (
        <p class="area-links">
          <span class="area-links__label">More about our work in</span>
          {LOCATIONS.map((l) => (
            <a href={`/locations/${l.slug}/`}>{l.name}</a>
          ))}
        </p>
      )}
    </div>
  </section>

  <!-- Closing band -->
  <section class="section bg-graphite close">
    <div class="container close__inner">
      <h2>Start with a quote or a phone call</h2>
      <p>
        Financing through SNAP is available on new equipment, and emergency service is available when a system quits on
        you.
      </p>
      <div class="close__cta">
        <a class="btn btn--primary" href="#contact-form">Get A Free Quote</a>
        <a class="btn btn--ghost-light" href={SITE.phoneHref}>Call {SITE.phone}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var success = document.getElementById('contact-success');
      var preferred = form.querySelector('[name="preferred_contact"]');
      var submitButton = form.querySelector('button[type="submit"]');
      var fallback = form.querySelector('.form-fallback');
      if (!preferred || !submitButton || !success) return;
      function updateContact() {
        form.querySelectorAll('[data-contact-field]').forEach(function (field) {
          var chosen = field.getAttribute('data-contact-field') === preferred.value;
          field.hidden = !chosen;
          field.querySelector('input').required = chosen;
          if (!chosen) field.querySelector('input').setAttribute('aria-invalid', 'false');
          if (!chosen) field.classList.remove('invalid');
        });
      }
      preferred.addEventListener('change', updateContact);
      updateContact();

      var rules = [
        {
          id: 'c-name',
          valid: function (v) {
            return v.trim().length >= 2;
          },
        },
        {
          id: 'c-phone',
          valid: function (v) {
            if (preferred.value !== 'phone') return true;
            var digits = v.replace(/\D/g, '');
            return digits.length >= 10 && digits.length <= 11;
          },
        },
        {
          id: 'c-email',
          valid: function (v) {
            return preferred.value !== 'email' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());
          },
        },
        {
          id: 'c-message',
          valid: function (v) {
            return v.trim().length >= 5;
          },
        },
      ];

      function check(rule) {
        var input = document.getElementById(rule.id);
        var field = input.closest('.field');
        var ok = rule.valid(input.value);
        field.classList.toggle('invalid', !ok);
        input.setAttribute('aria-invalid', ok ? 'false' : 'true');
        if (ok) {
          input.removeAttribute('aria-describedby');
        } else {
          input.setAttribute('aria-describedby', rule.id + '-error');
        }
        return ok;
      }

      rules.forEach(function (rule) {
        var input = document.getElementById(rule.id);
        input.addEventListener('blur', function () {
          check(rule);
        });
        input.addEventListener('input', function () {
          if (input.closest('.field').classList.contains('invalid')) check(rule);
        });
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        // Honeypot: real visitors never see or fill this field.
        var trap = document.getElementById('c-company');
        if (trap && trap.value) return;

        var firstBad = null;
        rules.forEach(function (rule) {
          if (!check(rule) && !firstBad) firstBad = document.getElementById(rule.id);
        });
        if (firstBad) {
          firstBad.focus();
          return;
        }

        var button = form.querySelector('button[type="submit"]');
        var status = form.querySelector('[role="status"]');
        if (!button || button.disabled) return;
        var fields = Array.from(form.querySelectorAll('input, select, textarea'));
        var data = new FormData(form);
        var submittedChannel = preferred.value;
        var payload = new URLSearchParams({
          '1.3': String(data.get('name') || '').trim(), '4': submittedChannel === 'phone' ? String(data.get('phone') || '').trim() : '',
          '2': submittedChannel === 'email' ? String(data.get('email') || '').trim() : '', '3': 'Contact preference: ' + submittedChannel + ' | ' + String(data.get('message') || '').trim(),
          '5.1': '', '5.3': String(data.get('city') || '').trim(), '5.5': String(data.get('postal') || '').trim(), source_url: window.location.href, date_created: new Date().toISOString(),
        });
        button.disabled = true;
        button.textContent = 'Sending...';
        fields.forEach(function (field) { field.disabled = true; });
        form.setAttribute('aria-busy', 'true');
        if (status) status.textContent = 'Sending your request...';
        var controller = new AbortController();
        var timer = window.setTimeout(function () { controller.abort(); }, 90000);
        try {
          var response = await fetch(form.action, {
            method: 'POST', mode: 'cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: payload.toString(), signal: controller.signal,
          });
          var result = await response.json();
          if (!response.ok || result.error || result.success === false || result.accepted === false || result.status === 'error'
            || (result.success !== true && result.accepted !== true)) throw new Error('Acceptance not confirmed');
          form.hidden = true;
          success.querySelector('p').textContent = 'Your request has been accepted. The service team will follow up by ' + (submittedChannel === 'email' ? 'email' : 'phone') + ' to confirm service availability and the next step. Submission does not book an appointment.';
          success.hidden = false;
          var heading = success.querySelector('h2, h3');
          heading.setAttribute('tabindex', '-1');
          heading.focus();
        } catch (error) {
          if (fallback) fallback.hidden = false;
          if (status) status.textContent = 'We could not confirm your request. Your details are still here. Please try again, call (519) 245-5945 or use the email link below.';
        } finally {
          window.clearTimeout(timer);
          button.disabled = false;
          button.textContent = 'Get A Free Quote';
          fields.forEach(function (field) { field.disabled = false; });
          form.removeAttribute('aria-busy');
        }
      });
      form.dataset.intakeReady = 'true';
      submitButton.disabled = false;
      if (fallback) fallback.hidden = true;
    })();
  </script>
</Base>

<style>
  /* ---- Page header ---- */
  .page-head__inner {
    display: grid;
    justify-items: start;
    gap: 16px;
  }
  .page-head h1 {
    max-width: 18ch;
  }

  /* ---- Form + details band ---- */
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }

  .contact-form,
  .contact-success {
    padding: clamp(24px, 4vw, 38px);
    grid-column: 1;
    grid-row: 1;
  }
  .contact-form:hover,
  .contact-success:hover {
    transform: none;
    box-shadow: var(--shadow-sm);
  }
  .contact-form h2 {
    margin-bottom: 10px;
  }
  .contact-form__note {
    color: var(--ink-soft);
    font-size: 0.98rem;
    margin-bottom: 24px;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  /* Keep inputs at 16px or larger so iOS does not zoom on focus. */
  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    font-size: 1.0625rem;
    min-height: 48px;
  }
  .contact-form textarea {
    min-height: 120px;
    resize: vertical;
  }
  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }
  .contact-form__hint {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .contact-success h2 {
    margin-bottom: 12px;
  }
  .contact-success p {
    color: var(--ink-soft);
    margin-bottom: 10px;
  }
  .contact-success__phone {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
  }
  .contact-success__phone a {
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .contact-success__phone a:hover {
    color: var(--red);
  }

  /* ---- Details column ---- */
  .details {
    grid-column: 2;
    grid-row: 1;
  }
  .details h2 {
    margin-bottom: 22px;
  }
  .details__list {
    list-style: none;
    display: grid;
    gap: 18px;
  }
  .details__list li {
    display: grid;
    justify-items: start;
    gap: 4px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--steel-200);
  }
  .details__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }
  .details address {
    font-style: normal;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.45;
  }
  .details__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.18rem;
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    word-break: break-word;
  }
  .details__value--email {
    font-size: 1.02rem;
  }
  .details__value:hover {
    color: var(--red);
  }
  .details__action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }
  .details__action:hover {
    color: var(--red);
  }
  .details__note {
    color: var(--ink-soft);
    font-size: 0.96rem;
    margin-top: 16px;
  }

  /* ---- Service area ---- */
  .areas {
    background: var(--white);
    border-block: 1px solid var(--steel-200);
  }
  .areas__head {
    max-width: 720px;
    margin-bottom: clamp(26px, 3vw, 38px);
  }
  .areas__head .eyebrow {
    margin-bottom: 10px;
  }
  .areas__head .temp-rule {
    margin: 18px 0;
  }
  .area-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    max-width: 900px;
  }
  .area-list li {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    padding: 8px 20px;
    border-left: 1px solid var(--steel-200);
  }
  .area-list li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .area-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 14px;
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  .area-links a {
    font-family: var(--font-display);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* ---- Closing band ---- */
  .close__inner {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 64ch;
  }
  .close__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Form stays first, details follow underneath. */
    .details {
      grid-column: 1;
      grid-row: 2;
    }
  }
  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .page-head__inner .btn,
    .close__cta .btn {
      width: 100%;
    }
    .close__cta {
      width: 100%;
    }
    .area-list li {
      padding-inline: 14px;
    }
  }
</style>
